      "requires_receipt_hash": true
    },
    {
      "retention_status": "quarantine",
      "full_bundle_retained_here": true,
      "requires_master_record_pointer": true,
      "requires_receipt_hash": true
    },
    {
      "retention_status": "superseded_pending_retention",
      "full_bundle_retained_here": true,
      "requires_master_record_pointer": true,
      "requires_receipt_hash": true
    },
    {
      "retention_status": "explicit_local_distribution",
      "full_bundle_retained_here": true,
      "requires_master_record_pointer": true,
